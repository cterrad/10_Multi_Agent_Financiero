# LLM Provider Configuration
# Choose LLM_PROVIDER: "huggingface", "openai", "gemini", "ollama", or "heuristic"
LLM_PROVIDER=huggingface

# Hugging Face Configuration (Default Open Source Non-Gated Models: Qwen or Mistral)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_token_here
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
# Alternative Mistral model: mistralai/Mistral-7B-Instruct-v0.3

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (Optional)
GOOGLE_API_KEY=your_google_api_key_here

# Financial Data APIs
FINNHUB_API_KEY=your_finnhub_api_key_here
# Opcional: buscador Tavily del Analista de Noticias. Sin esta clave el agente
# degrada esa fuente (lo declara en el informe) y usa Google News RSS + SEC 8-K.
TAVILY_API_KEY=your_tavily_api_key_here
SEC_EDGAR_USER_AGENT=FinancialAnalystAgent/1.0 (contact@example.com)

# Fundamental Gatekeeper Thresholds
# OJO: estos valores NO coinciden con los defaults de src/config.py
# (0.05 / 0.03 / 3.5). Si comparas resultados entre maquinas, comprueba
# primero cual de los dos esta activo: config.py los lee en tiempo de import.
MIN_REVENUE_GROWTH=0.05    # 5% YoY Revenue Growth
MIN_NET_MARGIN=0.05        # 5% Net Margin
MAX_DEBT_TO_EQUITY=3.0     # Max Debt-to-Equity ratio
# Excepciones sectoriales: en estos sectores el apalancamiento alto es
# estructural, no una senal de fragilidad. Aplicarles el umbral general
# es un error de categoria.
MAX_DE_FINANCIERAS=12.0
MAX_DE_INMOBILIARIO=5.0
MAX_DE_UTILITIES=5.0

# Analista de Calidad y Valoracion (todos opcionales; defaults en src/config.py)
PIOTROSKI_FUERTE=7             # F-Score a partir del cual la calidad contable es fuerte
ALTMAN_Z_DISTRESS=1.81         # por debajo, zona de insolvencia (Z clasico)
ALTMAN_ZDD_DISTRESS=1.10       # idem para la variante Z'' (no manufactureras)
ROIC_EXCELENTE=0.15            # ROIC a partir del cual el negocio se considera excelente
WACC_REFERENCIA=0.09           # coste de capital de referencia, constante y declarado
PEG_ATRACTIVO=1.25             # corte de Lynch para GARP
DEVENGOS_ALERTA=0.10           # ratio de Sloan a partir del cual el beneficio no es caja
COBERTURA_MINIMA_ESTILO=0.45   # sin esta cobertura no se emite etiqueta de estilo
# Pesos de la conviccion fundamental (deben sumar 1.0)
PESO_CALIDAD=0.35
PESO_VALORACION=0.25
PESO_CRECIMIENTO=0.20
PESO_SOLVENCIA=0.20

# Gestion de riesgo y construccion de cartera
CAPITAL_BASE=100000
RIESGO_POR_POSICION_PCT=0.0075 # riesgo del patrimonio por posicion si salta el stop
RIESGO_TOTAL_CARTERA_PCT=0.05  # riesgo agregado si TODOS los stops saltan a la vez
PESO_MAXIMO_POSICION=0.10
PESO_MINIMO_OPERABLE=0.01
EXPOSICION_BRUTA_MAXIMA=0.95
LIMITE_POR_SECTOR=0.30
MAXIMO_POSICIONES=20
VOLATILIDAD_OBJETIVO=0.25      # volatilidad anualizada objetivo por posicion
CORRELACION_ALTA=0.70          # a partir de aqui se penaliza el solapamiento
RENDIMIENTO_LIQUIDEZ_ANUAL=0.02

# Analista Tecnico
RSI_SOBRECOMPRA=70
RSI_SOBRECOMPRA_EXTREMA=80
MOMENTUM_ALCISTA_FUERTE=45     # cortes de la puntuacion continua [-100, +100]
MOMENTUM_ALCISTA=15

# Analista de Noticias (todos opcionales; los valores por defecto estan en src/config.py)
NEWS_WINDOW_DAYS=30          # ventana de antiguedad de las noticias
NEWS_HALFLIFE_DAYS=7         # semivida del decaimiento por antiguedad
NEWS_HIGH_IMPACT_THRESHOLD=0.60   # corte del bucket ALTA
NEWS_MEDIUM_IMPACT_THRESHOLD=0.30 # corte del bucket MEDIA
NEWS_CACHE_ENABLED=1         # cache por (ticker, dia) en data/cache/news

# System Configuration
OUTPUT_DIR=./output
PORT=8000
