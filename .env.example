# LLM Provider Configuration
# Choose LLM_PROVIDER: "huggingface", "openai", "gemini", "ollama", or "heuristic"
LLM_PROVIDER=huggingface

# Hugging Face Configuration (Default Open Source Non-Gated Models: Qwen or Mistral)
HUGGINGFACEHUB_API_TOKEN=your_huggingface_api_token_here
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
# Alternative Mistral model: mistralai/Mistral-7B-Instruct-v0.3

# OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini Configuration (Optional)
GOOGLE_API_KEY=your_google_api_key_here

# Financial Data APIs
FINNHUB_API_KEY=your_finnhub_api_key_here
# Opcional: buscador Tavily del Analista de Noticias. Sin esta clave el agente
# degrada esa fuente (lo declara en el informe) y usa Google News RSS + SEC 8-K.
TAVILY_API_KEY=your_tavily_api_key_here
SEC_EDGAR_USER_AGENT=FinancialAnalystAgent/1.0 (contact@example.com)

# Fundamental Gatekeeper Thresholds
MIN_REVENUE_GROWTH=0.05    # 5% YoY Revenue Growth
MIN_NET_MARGIN=0.05        # 5% Net Margin
MAX_DEBT_TO_EQUITY=3.0     # Max Debt-to-Equity ratio

# Analista de Noticias (todos opcionales; los valores por defecto estan en src/config.py)
NEWS_WINDOW_DAYS=30          # ventana de antiguedad de las noticias
NEWS_HALFLIFE_DAYS=7         # semivida del decaimiento por antiguedad
NEWS_HIGH_IMPACT_THRESHOLD=0.60   # corte del bucket ALTA
NEWS_MEDIUM_IMPACT_THRESHOLD=0.30 # corte del bucket MEDIA
NEWS_CACHE_ENABLED=1         # cache por (ticker, dia) en data/cache/news

# System Configuration
OUTPUT_DIR=./output
PORT=8000
